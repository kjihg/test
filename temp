"""
portfolio_bbg_vcv.py

Compute GBP-based daily returns, correlations, and annualised variance–covariance (VCV)
for a portfolio of ETFs using Bloomberg via pdblp (blpapi).

Inputs:
- positions: dict[str, float] mapping your local symbols (e.g. IBKR symbols) -> shares held
- symbol_to_bbg: dict[str, str] mapping local symbol -> Bloomberg security (e.g. "VWRL" -> "VWRL LN Equity")

Features:
- Fetches each security's currency from Bloomberg using a robust fallback list of fields
- Pulls daily prices from Bloomberg (PX_LAST)
- Pulls FX from Bloomberg to convert everything into GBP before computing returns
- Computes:
  - GBP daily returns per security
  - Correlation matrix
  - Annualised variance–covariance matrix (VCV)
  - Recent-window correlation/VCV
  - Portfolio daily returns (value-weighted) and total return over window

Requirements:
    pip install pdblp pandas numpy
    Bloomberg Terminal/API access (blpapi) available on the machine
"""

from __future__ import annotations

from dataclasses import dataclass
from typing import Dict, List, Optional, Tuple

import numpy as np
import pandas as pd


DEFAULT_BBG_TICKERS: Dict[str, str] = {
    "XMME": "XMME LN Equity",
    "EIMI": "EIMI LN Equity",
    "S7XP": "S7XP LN Equity",
    "VFEM": "VFEM LN Equity",
    "VWRL": "VWRL LN Equity",
    "COPX": "COPX LN Equity",
    "IGUS": "IGUS LN Equity",
    "REMX": "REMX LN Equity",
    "ISPE": "ISPE LN Equity",
}


@dataclass
class BloombergConfig:
    host: str = "localhost"
    port: int = 8194
    timeout: int = 20000


class BloombergClient:
    """
    Thin wrapper around pdblp.BCon.

    Notes:
      - pdblp uses `ref()` for Bloomberg reference data (BDP equivalent).
      - pdblp uses `bdh()` for Bloomberg historical data (BDH).
    """

    def __init__(self, config: BloombergConfig):
        self.config = config
        self._con = None

    def __enter__(self):
        import pdblp

        self._con = pdblp.BCon(
            host=self.config.host,
            port=self.config.port,
            timeout=self.config.timeout,
        )
        self._con.start()
        return self

    def __exit__(self, exc_type, exc, tb):
        if self._con is not None:
            try:
                self._con.stop()
            except Exception:
                pass
        self._con = None

    @property
    def con(self):
        if self._con is None:
            raise RuntimeError("BloombergClient not started. Use within a context manager.")
        return self._con

    def bdh(self, tickers: List[str], flds: List[str], start: str, end: str) -> pd.DataFrame:
        df = self.con.bdh(tickers=tickers, flds=flds, start_date=start, end_date=end)
        if df is None or df.empty:
            raise RuntimeError("BDH returned empty data. Check tickers/fields/dates and Bloomberg connectivity.")
        return df

    def ref(self, tickers: List[str], flds: List[str]) -> pd.DataFrame:
        df = self.con.ref(tickers, flds)
        if df is None or df.empty:
            raise RuntimeError("REF returned empty data. Check tickers/fields and Bloomberg connectivity.")
        return df


class PortfolioAnalyzer:
    # Currency fields to try in order (Bloomberg field mnemonics vary by instrument/type)
    CURRENCY_FIELDS = ["CRNCY", "CRNCY_TRADING", "TRADE_CRNCY", "PRICE_CURRENCY", "FUND_CRNCY"]

    def __init__(
        self,
        bbg_config: BloombergConfig = BloombergConfig(),
        symbol_to_bbg: Optional[Dict[str, str]] = None,
        base_ccy: str = "GBP",
    ):
        self.bbg_config = bbg_config
        self.symbol_to_bbg = symbol_to_bbg or DEFAULT_BBG_TICKERS.copy()
        self.base_ccy = base_ccy.upper()

    # ---------------- Bloomberg fetch helpers ----------------

    def _fetch_security_currencies(self, bbg_tickers: List[str]) -> Dict[str, str]:
        """
        Robustly fetch a currency code for each security using a fallback list of fields.
        Returns: {bbg_ticker: 'GBP'/'USD'/...}
        """
        fields = self.CURRENCY_FIELDS + ["ID_BB_GLOBAL", "SECURITY_DES"]
        with BloombergClient(self.bbg_config) as bbg:
            ref = bbg.ref(bbg_tickers, fields)

        out: Dict[str, str] = {}

        # Ensure expected rows exist; if not, give actionable error
        missing_rows = [t for t in bbg_tickers if t not in ref.index]
        if missing_rows:
            raise RuntimeError(
                "REF did not return rows for some tickers. "
                f"Missing: {missing_rows}. "
                "This usually means the Bloomberg ticker isn't resolving on your setup. "
                "Try confirming the ticker on the Terminal (e.g., 'XMME LN Equity') "
                "or use an identifier like ISIN with '/ISIN' syntax."
            )

        for t in bbg_tickers:
            row = ref.loc[t]
            ccy_val = None
            for f in self.CURRENCY_FIELDS:
                if f in ref.columns:
                    v = row.get(f, np.nan)
                    if pd.notna(v) and str(v).strip() != "":
                        ccy_val = str(v).upper()
                        break

            if ccy_val is None:
                bb = row.get("ID_BB_GLOBAL", "")
                des = row.get("SECURITY_DES", "")
                raise RuntimeError(
                    f"Could not determine currency for {t}. "
                    f"Tried fields {self.CURRENCY_FIELDS}. "
                    f"Bloomberg resolution info: ID_BB_GLOBAL={bb}, SECURITY_DES={des}. "
                    "Try using a different currency field or confirm the exact share class/ticker."
                )

            out[t] = ccy_val

        return out

    @staticmethod
    def _extract_field_frame(df_bdh: pd.DataFrame, field: str) -> pd.DataFrame:
        if not isinstance(df_bdh.columns, pd.MultiIndex):
            raise ValueError("Expected MultiIndex columns from BDH: (ticker, field).")

        # pdblp typically: level 0=ticker, level 1=field
        try:
            out = df_bdh.xs(field, axis=1, level=1)
        except Exception:
            out = df_bdh.xs(field, axis=1, level=-1)

        out.columns = [str(c) for c in out.columns]
        return out

    def _fetch_prices(self, bbg_tickers: List[str], start: str, end: str) -> pd.DataFrame:
        with BloombergClient(self.bbg_config) as bbg:
            hist = bbg.bdh(bbg_tickers, ["PX_LAST"], start, end)
        px = self._extract_field_frame(hist, "PX_LAST")
        return px.sort_index().dropna(how="all")

    # ---------------- FX logic ----------------

    def _build_fx_request_list(
        self, ccy_set: set
    ) -> Tuple[List[str], Dict[str, Tuple[Tuple[str, bool], Tuple[str, bool]]]]:
        base = self.base_ccy
        candidates = {}
        fx_tickers = []

        for ccy in sorted(ccy_set):
            ccy = str(ccy).upper()
            if ccy == base:
                continue

            direct = f"{ccy}{base} Curncy"
            inverse = f"{base}{ccy} Curncy"

            candidates[ccy] = ((direct, False), (inverse, True))
            fx_tickers.extend([direct, inverse])

        return fx_tickers, candidates

    def _fetch_fx_to_base(self, currencies: set, start: str, end: str) -> Dict[str, pd.Series]:
        base = self.base_ccy
        fx_tickers_to_try, candidates = self._build_fx_request_list(currencies)

        if not fx_tickers_to_try:
            return {base: pd.Series(dtype=float)}

        with BloombergClient(self.bbg_config) as bbg:
            fx_hist = bbg.bdh(fx_tickers_to_try, ["PX_LAST"], start, end)

        fx_px = self._extract_field_frame(fx_hist, "PX_LAST").sort_index()
        fx_series_by_ccy: Dict[str, pd.Series] = {base: pd.Series(1.0, index=fx_px.index)}

        for ccy, (opt1, opt2) in candidates.items():
            (t1, inv1) = opt1
            (t2, inv2) = opt2

            s1 = fx_px[t1] if t1 in fx_px.columns else None
            s2 = fx_px[t2] if t2 in fx_px.columns else None

            s1_ok = s1 is not None and s1.dropna().shape[0] > 0
            s2_ok = s2 is not None and s2.dropna().shape[0] > 0

            if s1_ok:
                s = s1.astype(float)
                if inv1:
                    s = 1.0 / s
                fx_series_by_ccy[ccy] = s
            elif s2_ok:
                s = s2.astype(float)
                if inv2:
                    s = 1.0 / s
                fx_series_by_ccy[ccy] = s
            else:
                raise RuntimeError(f"Could not fetch FX for {ccy}->{base}. Tried {t1} and {t2}.")

        return fx_series_by_ccy

    # ---------------- Core analytics ----------------

    def compute_base_prices_and_returns(
        self,
        positions: Dict[str, float],
        start: str,
        end: str,
        symbols: Optional[List[str]] = None,
    ) -> Dict[str, object]:
        if symbols is None:
            symbols = list(positions.keys())

        missing = [s for s in symbols if s not in self.symbol_to_bbg]
        if missing:
            raise ValueError(f"Missing Bloomberg ticker mapping for symbols: {missing}")

        bbg_tickers = [self.symbol_to_bbg[s] for s in symbols]

        sec_ccy = self._fetch_security_currencies(bbg_tickers)
        px_local = self._fetch_prices(bbg_tickers, start, end)

        got = [t for t in bbg_tickers if t in px_local.columns]
        if len(got) != len(bbg_tickers):
            missing_px = sorted(set(bbg_tickers) - set(got))
            raise RuntimeError(f"Missing PX_LAST series for: {missing_px}")

        ccy_set = set(sec_ccy.values())
        fx_map = self._fetch_fx_to_base(ccy_set, start, end)

        px_base = pd.DataFrame(index=px_local.index)
        for t in got:
            ccy = sec_ccy[t]
            fx_series = pd.Series(1.0, index=px_local.index) if ccy == self.base_ccy else fx_map[ccy].reindex(px_local.index).ffill()
            px_base[t] = px_local[t].astype(float) * fx_series.astype(float)

        rets_base = px_base.pct_change().dropna(how="all")

        return {
            "bbg_tickers": bbg_tickers,
            "security_currency": sec_ccy,
            "px_local": px_local,
            "fx_to_base": fx_map,
            "px_base": px_base,
            "rets_base": rets_base,
        }

    @staticmethod
    def correlation_matrix(returns: pd.DataFrame) -> pd.DataFrame:
        return returns.corr()

    @staticmethod
    def covariance_matrix_annualised(returns: pd.DataFrame, annualisation_factor: int = 252) -> pd.DataFrame:
        return returns.cov() * annualisation_factor

    def portfolio_daily_returns_base(
        self,
        positions: Dict[str, float],
        px_base: pd.DataFrame,
        symbols: Optional[List[str]] = None,
    ) -> pd.Series:
        if symbols is None:
            symbols = list(positions.keys())

        bbg_tickers = [self.symbol_to_bbg[s] for s in symbols]
        missing = [t for t in bbg_tickers if t not in px_base.columns]
        if missing:
            raise ValueError(f"Missing base-currency prices for tickers: {missing}")

        mv = pd.DataFrame(index=px_base.index)
        for sym, shares in positions.items():
            if sym not in self.symbol_to_bbg:
                continue
            t = self.symbol_to_bbg[sym]
            mv[t] = px_base[t] * float(shares)

        mv = mv.dropna(how="all")
        total_mv = mv.sum(axis=1)

        rets = px_base[bbg_tickers].pct_change()
        w_lag = mv.div(total_mv, axis=0).shift(1)

        return (w_lag * rets).sum(axis=1).dropna()

    @staticmethod
    def portfolio_total_return_from_daily(port_rets: pd.Series) -> float:
        return float((1.0 + port_rets).prod() - 1.0)

    def run_full_analysis(
        self,
        positions: Dict[str, float],
        start: str,
        end: str,
        recent_window_days: int = 60,
        annualisation_factor: int = 252,
    ) -> Dict[str, object]:
        data = self.compute_base_prices_and_returns(positions, start, end)
        rets = data["rets_base"]

        corr_full = self.correlation_matrix(rets)
        vcv_full = self.covariance_matrix_annualised(rets, annualisation_factor)

        rets_recent = rets.tail(recent_window_days)
        corr_recent = self.correlation_matrix(rets_recent)
        vcv_recent = self.covariance_matrix_annualised(rets_recent, annualisation_factor)

        port_rets = self.portfolio_daily_returns_base(positions, data["px_base"])
        port_total = self.portfolio_total_return_from_daily(port_rets)

        return {
            **data,
            "corr_full": corr_full,
            "vcv_full_annualised": vcv_full,
            "corr_recent": corr_recent,
            "vcv_recent_annualised": vcv_recent,
            "portfolio_daily_returns_base": port_rets,
            "portfolio_total_return_over_window": port_total,
            "recent_window_days": recent_window_days,
            "annualisation_factor": annualisation_factor,
            "base_ccy": self.base_ccy,
        }


if __name__ == "__main__":
    positions = {
        "XMME": 100,
        "EIMI": 200,
        "S7XP": 200,
        "VFEM": 200,
        "VWRL": 200,
        "COPX": 1000,
        "IGUS": 1000,
        "REMX": 2500,
        "ISPE": 3000,
    }

    start = "2024-02-01"
    end = "2026-02-01"

    analyzer = PortfolioAnalyzer(
        bbg_config=BloombergConfig(host="localhost", port=8194, timeout=20000),
        symbol_to_bbg=DEFAULT_BBG_TICKERS,
        base_ccy="GBP",
    )

    results = analyzer.run_full_analysis(
        positions=positions,
        start=start,
        end=end,
        recent_window_days=60,
        annualisation_factor=252,
    )

    print("\n=== Base currency ===")
    print(results["base_ccy"])

    print("\n=== Security currencies (Bloomberg) ===")
    for t, c in results["security_currency"].items():
        print(f"{t:20s} {c}")

    print("\n=== Correlation (full window) ===")
    print(results["corr_full"].round(3))

    print("\n=== Annualised VCV (full window) ===")
    print(results["vcv_full_annualised"].round(6))

    print("\n=== Correlation (recent window) ===")
    print(results["corr_recent"].round(3))

    print("\n=== Annualised VCV (recent window) ===")
    print(results["vcv_recent_annualised"].round(6))

    print(f"\n=== Portfolio total return over window ({results['base_ccy']}) ===")
